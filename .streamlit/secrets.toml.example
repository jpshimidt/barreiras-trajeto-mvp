# Copie para secrets.toml (não versionar) ou use no Streamlit Cloud → Settings → Secrets.

ORS_API_KEY = "cole-sua-chave-openrouteservice"

# Server-side: Places API (New) + Geocoding — busca de endereços no app (obrigatório para autocomplete).
GOOGLE_MAPS_API_KEY = "cole-sua-chave-google-server"

# Opcional — não é mais usada pelo app (autocomplete agora é server-side).
# GOOGLE_MAPS_JS_KEY = "cole-sua-chave-google-javascript"

# Login — gere o hash da senha UMA VEZ e cole em `password` abaixo.
# Na tela do app, use usuário (ex.: admin) + senha NORMAL (texto), nunca o hash.
#   python3 -c "import streamlit_authenticator as stauth; print(stauth.Hasher.hash('sua-senha'))"
[auth]
cookie_name = "barreiras_auth"
cookie_key = "SUBSTITUA-por-string-aleatoria-com-pelo-menos-32-caracteres"
cookie_expiry_days = 30
admin_usernames = ["admin"]

[auth.credentials.usernames.demo]
email = "demo@exemplo.org"
name = "Usuário demo"
password = "$2b$12$SUBSTITUA_PELO_HASH_BCRYPT_DA_SUA_SENHA"

[auth.credentials.usernames.admin]
email = "admin@exemplo.org"
name = "Administrador"
password = "$2b$12$SUBSTITUA_PELO_HASH_BCRYPT_DO_ADMIN"

# Persistência do cadastro de barreiras (sobrevive a redeploys no Streamlit Cloud).
# Crie um Personal Access Token (classic) com escopo ``repo`` (ou fine-grained: Contents read/write).
[github_barreiras]
token = "ghp_SUBSTITUA"
repo = "seu-usuario/barreiras-trajeto-mvp"
path = "dados/barreiras.geojson"
branch = "main"
