# Copie para secrets.toml (não versionar) ou use no Streamlit Cloud → Settings → Secrets.

ORS_API_KEY = "cole-sua-chave-openrouteservice"

# Places API + Maps JavaScript (Autocomplete no app). Ative Places API (New) e Maps JavaScript API.
GOOGLE_MAPS_API_KEY = "cole-sua-chave-google-maps"

# Login — gere o hash da senha com:
#   python3 -c "import streamlit_authenticator as stauth; print(stauth.Hasher.hash(['sua-senha']))"
[auth]
cookie_name = "barreiras_auth"
cookie_key = "gere-uma-string-aleatoria-longa-e-secreta"
cookie_expiry_days = 30

[auth.credentials.usernames.demo]
email = "demo@exemplo.org"
name = "Usuário demo"
# Senha de exemplo: troque em produção. Com auto_hash do authenticator, texto puro também funciona.
password = "senha-demo-trocar"
